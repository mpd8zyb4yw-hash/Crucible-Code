{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crucible",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  // The brain reuses server/* verbatim; those modules lean on Node built-ins
  // for nothing at runtime, but the flag keeps `Buffer`-shaped helpers in any
  // transitive dependency working rather than failing at the edge.
  "compatibility_flags": ["nodejs_compat"],

  // The built frontend is served by this same Worker, so there is one origin,
  // one deploy, and no CORS between the app and its API.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A single-page app: unknown paths are routes, not 404s.
    "not_found_handling": "single-page-application",
    // /api/* and /auth/* must reach the Worker even though assets exist.
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Everything that is not the world model: the Google refresh token, model
  // routing state, panes, the shelf, the feed snapshot. Also where the world
  // model USED to live — see the Durable Object below. The room seeds itself
  // from this key on its first request and mirrors every landed write back to
  // it, so `wrangler kv key get world` still reads his life.
  "kv_namespaces": [
    { "binding": "CRUCIBLE", "id": "7288f617e7904a0fa9a96bda11dd6540" }
  ],

  // THE WORLD MODEL'S ONE AUTHORITATIVE WRITER.
  //
  // KV has no conditional write, so the compare-and-set against it was
  // read-hash-compare-write with a real — if narrow — window between the check
  // and the put. That was tolerable while the document held re-syncable
  // observations and is not tolerable now that it holds his corrections, which
  // nothing will ever re-derive. A Durable Object is single across the whole
  // network and gates its own requests, so the compare and the assignment
  // happen in one turn with nothing able to interleave. See server/worldRoom.ts.
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "WorldObject" }]
  },
  // SQLite-backed, which is the current default class and the one with the
  // larger per-value ceiling. The document is chunked either way, because a
  // world model that fails to save because it grew is the same silent loss the
  // object exists to prevent.
  //
  // THE SQLITE BACKEND IS NOW LOAD-BEARING FOR A SECOND REASON. The memory core
  // (server/memory/, docs/memory-core.md) keeps its ledger in this same object's
  // `state.storage.sql` — the same object rather than a second one, because
  // there is exactly one WorldObject per user and its requests are gated, so a
  // write to the ledger and a write to the document cannot interleave. Two
  // objects would need a distributed transaction to promise that.
  //
  // A deploy without this migration has no `state.storage.sql`, and the memory
  // core is then simply absent — the object says so and serves the world model
  // exactly as before, rather than failing. Moving this class back to the classic
  // backend would silently switch the ledger off.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorldObject"] }
  ],

  // A route, not a custom domain: crucible.cam already has proxied DNS records
  // pointing at an older origin, and a custom domain would have required
  // deleting them. A route attaches this Worker to the existing hostname
  // without touching DNS, and detaching it puts the old origin back.
  "routes": [
    { "pattern": "crucible.cam/*", "zone_name": "crucible.cam" }
  ],

  // Two cadences, for two things that go stale at different rates.
  //
  //   */15 — let the clock tick on panes with an interval policy, and rewrite
  //          the feed snapshot so opening the app is current rather than
  //          three hours old. `refreshDue` still gates each pane on its OWN
  //          interval, so this fetches nothing nobody asked for.
  //   0 */3 — the expensive half: pull Google, run standing interests. The
  //          sources it reads do not change faster than that, and the free
  //          tier's daily allowance is better spent on synthesis he reads.
  //
  // The handler branches on `event.cron`; the string below is matched against
  // LIGHT_CRON in worker/index.ts, so the two have to stay in step.
  // ONE TICK. `server/sync.ts` decides per source whether anything is actually
  // due, so a tick with fresh sources makes no connector call at all — which is
  // what makes five minutes affordable where the old all-or-nothing pull was
  // stuck at three hours. Calendar and mail are the reason for the number.
  "triggers": { "crons": ["*/5 * * * *"] },

  "observability": { "enabled": true }

  // Secrets — set each with `wrangler secret put <NAME>`:
  //   JWT_SECRET            signs the session cookie
  //   GOOGLE_CLIENT_ID      /  GOOGLE_CLIENT_SECRET
  //   ALLOWED_EMAIL         the one Google account allowed to sign in
  //   GEMINI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, …  the brain
  //   BRAVE_API_KEY, TAVILY_API_KEY                        optional search
}
