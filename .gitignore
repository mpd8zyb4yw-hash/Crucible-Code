node_modules/
dist/
build/
release/
server-dist/
# app/ is the built frontend the server serves at :3001. There is NO build step at
# deploy time — the phone loads whatever app/ is committed — so the bundle MUST be
# tracked. vite emits new content-hashed filenames each build, so the whole dir stays
# tracked: after any src/*.tsx|*.css change, run `npx vite build` and commit app/.
.env.local
.env*.local
.circuit-state.json
.DS_Store
*.log
.vite/
.crucible/
.crucible-checkpoints.json
*.tsbuildinfo
*.save
.env.clean
.dev.vars
.wrangler/
*.db-shm
*.db-wal
Crucible UI redesign.zip
Crucible UI redesign/
Crucible UI v3.zip
.bench-history.jsonl

# Audit session artifacts — traces contain a minted session token in fire.sh usage.
# The bare rule below only matched a token directly under audit-traces/, NOT nested
# paths like audit-traces/p2/.token (which is how they are actually written), so two
# expired JWTs got committed. Match at any depth.
audit-traces/.token
audit-traces/**/.token

# ── Secret / credential hardening (defense-in-depth) ─────────────────────────────
# Never commit real secret material. Templates use the .example suffix and stay tracked.
**/.token
.env
.env.*
.dev.vars
*.pem
*.key
*_rsa
id_rsa
*.p12
*.pfx
!*.example
!.env.production.example
!.dev.vars.example

# Written by scripts/deploy.sh — the last shipped fingerprint, and its log.
.crucible-deploy-stamp
.crucible-deploy.log
# The deploy reconciler's own bookkeeping: its last verdict, its single-instance
# lock, and the watchdog's launchd output. All machine-local state about THIS
# checkout, none of it meaningful anywhere else.
.crucible-deploy-state
.crucible-deploy.lock/
.crucible-watchdog.log

# Generated at build time; never meaningful in a diff.
server/build.ts

# Visual gate output — evidence, regenerated by `npm run shots`.
shots/

# Agent bridge — local dev transport. Secrets, checkpoints, journal, logs.
agent-bridge/.secrets/
.agent-bridge/
